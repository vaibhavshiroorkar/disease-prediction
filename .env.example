# Leave DATABASE_URL unset for an unlogged public demo.
DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this on the server. Send it only in the X-API-Key header for review routes.
ADMIN_API_KEY=
PORT=8000
PRELOAD_MODELS=1
RATE_LIMIT_PER_MINUTE=60
# Same-origin frontend needs no CORS configuration.
ALLOWED_ORIGINS=
# Uvicorn trusts only these reverse proxy IPs for forwarded client addresses.
FORWARDED_ALLOW_IPS=127.0.0.1
# Proxies that append to X-Forwarded-For. Set 1 on Render, where proxy addresses change.
TRUSTED_PROXY_HOPS=0
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5
